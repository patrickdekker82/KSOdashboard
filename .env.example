# Showroom Suite — omgevingsvariabelen voor ontwikkeling.
# In productie staat alles in de instellingen van de app; dit bestand is
# alleen bedoeld om de kern lokaal te kunnen draaien.

# Waar de database, back-ups en bijlagen komen te staan.
# Laat leeg om de standaardmap van de app te gebruiken.
SHOWROOM_DATA_DIR=./.data

# Poort voor de hostmodus. In alleenstaande modus kiest de app zelf een
# vrije poort op 127.0.0.1.
SHOWROOM_PORT=4317

# Microsoft 365 (hoofdstuk 6.7). Publieke client met PKCE: er is GEEN
# clientgeheim, maak er ook geen aan.
SHOWROOM_GRAPH_TENANT_ID=
SHOWROOM_GRAPH_CLIENT_ID=

# Anthropic (hoofdstuk 6.8). In productie versleuteld opgeslagen via de
# Windows-sleutelopslag; hier alleen voor ontwikkeling.
ANTHROPIC_API_KEY=
